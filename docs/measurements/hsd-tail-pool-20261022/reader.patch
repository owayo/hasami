+    fn test_canonical_shared_tail_pool() {
+        let keys = ["a共通", "b共通"];
+        let mut parts = build_indexed(&keys);
+        let (left, _) = node_at(&parts, "a");
+        let (right, _) = node_at(&parts, "b");
+        // Two different values, one physical UTF-8 string after both records.
+        parts.tails = [0u32, 16, 1, 16]
+            .into_iter()
+            .flat_map(u32::to_le_bytes)
+            .collect();
+        push_varint(&mut parts.tails, 6);
+        parts.tails.extend_from_slice("共通".as_bytes());
+        parts.nodes[left].base = KIND_TAIL << KIND_SHIFT;
+        parts.nodes[right].base = (KIND_TAIL << KIND_SHIFT) | 8;
+        assert_round_trip(&keys, &[0, 1], &parts);
+        let trie = parts.as_trie().unwrap();
+        assert_eq!(search(&trie, "a共通です", 0), vec![(7, 0)]);
+        assert_eq!(search(&trie, "b共通です", 0), vec![(7, 1)]);
+        let (coded, result) = search_codes(&trie, "b共通です", 0);
+        result.unwrap();
+        assert_eq!(coded, search(&trie, "b共通です", 0));
+
+        for pointer in [u32::MAX, parts.tails.len() as u32] {
+            let mut broken = parts.clone();
+            broken.tails[4..8].copy_from_slice(&pointer.to_le_bytes());
+            assert!(broken.as_trie().unwrap().verify(2).is_err());
+            for text in ["a", "a違う", "a共通"] {
+                assert!(
+                    broken
+                        .as_trie()
+                        .unwrap()
+                        .common_prefix_search(text, 0, |_, _| {})
+                        .is_err()
+                );
+            }
+        }
+        let mut truncated = parts;
+        truncated.tails.truncate(7);
+        assert!(truncated.as_trie().unwrap().get("a共通").is_err());
+    }
