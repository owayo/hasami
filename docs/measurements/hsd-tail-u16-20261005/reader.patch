+#[cfg(test)]
+mod tail_u16_tests {
+    use super::*;
+
+    #[test]
+    fn ordinary_and_precomputed_search_report_the_same_order_and_byte_end() {
+        let long = format!("a{}🙂", "東".repeat(300));
+        let mut keys = vec![
+            "a".to_string(),
+            "a東京🙂".to_string(),
+            "a東亜".to_string(),
+            "z文".to_string(),
+            long.clone(),
+        ];
+        keys.sort();
+        let refs: Vec<&str> = keys.iter().map(String::as_str).collect();
+        let values: Vec<u32> = (0..keys.len() as u32).collect();
+        let parts = build(&refs, &values).unwrap();
+        let trie = parts.as_trie().unwrap();
+        let mut recovered = trie.keys().unwrap();
+        recovered.sort_by(|a, b| a.1.cmp(&b.1));
+        assert_eq!(
+            recovered,
+            values
+                .iter()
+                .copied()
+                .zip(keys.iter().cloned())
+                .collect::<Vec<_>>()
+        );
+        assert_eq!(trie.verify(values.len() as u32).unwrap().keys, keys.len());
+        for text in [
+            "a東京🙂続き",
+            "a東亜",
+            "a",
+            "aa",
+            "xa東京🙂",
+            "a東X",
+            "🙂a東京🙂",
+        ]
+        .map(String::from)
+        .into_iter()
+        .chain([long])
+        {
+            let codes: Vec<u16> = text.chars().map(|c| trie.char_code(c) as u16).collect();
+            let mut offsets: Vec<u32> = text.char_indices().map(|(i, _)| i as u32).collect();
+            offsets.push(text.len() as u32);
+            for start in 0..=codes.len() {
+                let mut normal = Vec::new();
+                let mut coded = Vec::new();
+                trie.common_prefix_search(&text, offsets[start] as usize, |end, v| {
+                    normal.push((end, v))
+                })
+                .unwrap();
+                trie.common_prefix_search_codes(&text, &codes, &offsets, start, |end, v| {
+                    coded.push((offsets[end] as usize, v))
+                })
+                .unwrap();
+                assert_eq!(normal, coded, "text={text:?} start={start}");
+            }
+        }
+    }
+
+    fn assert_rejected(parts: &TrieParts) {
+        let trie = parts.as_trie().unwrap();
+        // Both short input and an early mismatch must still reject a bad late code.
+        assert!(trie.get("a").is_err());
+        assert!(trie.get("aX").is_err());
+        let codes = [trie.char_code('a') as u16, 0];
+        let mut hits = Vec::new();
+        assert!(
+            trie.common_prefix_search_codes("aX", &codes, &[0, 1, 2], 0, |p, v| hits.push((p, v)))
+                .is_err()
+        );
+        assert!(trie.keys().is_err());
+        assert!(trie.verify(1).is_err());
+    }
+
+    #[test]
+    fn corrupt_codes_lengths_values_and_truncation_are_rejected() {
+        let fixture = build(&["a東京🙂"], &[0]).unwrap();
+        let node = fixture
+            .nodes
+            .iter()
+            .find(|n| kind(n.base) == KIND_TAIL)
+            .unwrap();
+        let off = (node.base & PAYLOAD_MASK) as usize;
+        let (count, body) = read_varint(&fixture.tails, off + 4).unwrap();
+        assert_eq!(count, 3);
+        let max = fixture.as_trie().unwrap().max_code() as u16;
+        for bad in [0u16, max + 1] {
+            let mut p = fixture.clone();
+            let last = body + (count as usize - 1) * 2;
+            p.tails[last..last + 2].copy_from_slice(&bad.to_le_bytes());
+            assert_rejected(&p);
+        }
+        let mut zero = fixture.clone();
+        zero.tails[off + 4] = 0;
+        assert_rejected(&zero);
+        let mut truncated = fixture.clone();
+        truncated.tails.pop();
+        assert_rejected(&truncated);
+        let mut overflow = fixture.clone();
+        overflow.tails[off + 4..off + 9].copy_from_slice(&[0xff, 0xff, 0xff, 0xff, 0x10]);
+        assert_rejected(&overflow);
+        let mut too_long = fixture.clone();
+        too_long.tails[off + 4..off + 9].copy_from_slice(&[0xff, 0xff, 0xff, 0xff, 0x0f]);
+        assert_rejected(&too_long);
+        let mut value = fixture.clone();
+        value.tails[off..off + 4].copy_from_slice(&VALUE_LIMIT.to_le_bytes());
+        assert_rejected(&value);
+    }
+}
