#!/bin/sh
# 50MB を超えるファイルのコミットを止める。
#
# 配布辞書 (dict/*.hsd) のような大きなファイルはリポジトリに置かず、リリースに添付する。
# 一度コミットすると GitHub の 100MB 制限で push が通らなくなり、履歴を書き換えるしかなくなる。
#
# 有効にする: make setup-hooks

limit=52428800 # 50MB

fail=0
# パスは 1 行ずつ読む (空白やワイルドカードの文字を含む名前を分割・展開しない)。
# :0:<パス> はインデックスに置いた内容
while IFS= read -r path; do
	[ -n "$path" ] || continue
	size=$(git cat-file -s ":0:$path" 2>/dev/null) || continue
	[ "$size" -gt "$limit" ] || continue

	printf 'error: %s (%d MB) is larger than 50 MB\n' "$path" "$((size / 1048576))" >&2
	fail=1
done <<EOF
$(git -c core.quotePath=false diff --cached --name-only --diff-filter=AM)
EOF

if [ "$fail" -ne 0 ]; then
	printf '\n大きなファイルはコミットしない。配布辞書はリポジトリに置かず、リリースに添付する。\n' >&2
	printf 'git restore --staged <path> で外してください。意図的に入れる場合は --no-verify で回避できます。\n' >&2
	exit 1
fi
